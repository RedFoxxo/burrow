{
  "name": "burrow-wiki-tests",
  "private": true,
  "description": "Runs every burrow tool against a real LeafWiki through the official MCP client. burrow itself is the Rust crate in this folder.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:wiki": "cargo build --release && vitest run --config vitest.wiki.config.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
